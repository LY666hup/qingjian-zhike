.tutorial-tabs{gap:10rpx}.tutorial-tabs .tab{font-size:22rpx;padding:12rpx 18rpx}.video-grid{display:flex;flex-wrap:wrap;gap:20rpx}.tutorial-card{width:calc(50% - 10rpx);min-width:0;border-radius:24rpx;overflow:hidden;border:1rpx solid #dfebe3;background:white;box-shadow:0 8rpx 24rpx rgba(24,63,51,.04)}.poster-wrap{position:relative;background:#eff7f2;height:240rpx}.tutorial-poster{width:100%;height:100%;display:block}.play-badge{position:absolute;bottom:14rpx;right:14rpx;background:rgba(23,63,53,.85);color:white;width:44rpx;height:44rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18rpx;padding-left:3rpx}.tutorial-body{padding:22rpx 20rpx}.tutorial-body .name{font-size:28rpx}.tutorial-description{font-size:20rpx;color:#7b9383;line-height:1.7;min-height:68rpx;margin-top:8rpx}.tutorial-bottom{font-size:17rpx;color:#659174;margin-top:18rpx;display:flex;justify-content:space-between;gap:8rpx}
