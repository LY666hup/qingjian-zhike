.report-numbers{display:flex;justify-content:space-between;margin-top:30rpx}.menu-card{padding-top:4rpx;padding-bottom:4rpx}.advice-headline{font-size:38rpx;font-weight:700;margin:20rpx 0;line-height:1.5}.source-tag{font-size:21rpx;color:#3f725a}.evidence-dot{width:10rpx;height:10rpx;border-radius:50%;background:#3a9b73;flex-shrink:0}.selected-card{border:2rpx solid #298a63;background:#edf9f1}

.feedback-note{display:block;box-sizing:border-box;width:100%;height:180rpx;background:#f3f8f4;border:1rpx solid #e1ebe4;border-radius:18rpx;padding:20rpx;font-size:25rpx;line-height:1.6;margin-top:24rpx;color:#365b45}.feedback-buttons{display:flex;gap:12rpx;margin-top:22rpx;flex-wrap:wrap}.feedback-buttons button{flex:1;padding:0 12rpx;min-width:140rpx;font-size:22rpx}.save-result{color:#247951;font-size:23rpx;margin-top:20rpx}
