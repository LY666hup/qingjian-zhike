page {
  min-height: 100%;
  color: #17251f;
  background: #f3f7f5;
}

.page {
  min-height: 100vh;
  padding: 28rpx 26rpx 30rpx;
  box-sizing: border-box;
}

.profileBar,
.profileMain,
.heroTop,
.heroStats,
.sectionHeading,
.adviceCard,
.taskRow,
.insightTop,
.recordMetrics {
  display: flex;
  align-items: center;
}

.profileBar,
.heroTop,
.sectionHeading,
.insightTop {
  justify-content: space-between;
}

.profileMain { min-width: 0; gap: 18rpx; }

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border: 3rpx solid #fff;
  border-radius: 50%;
  font-size: 35rpx;
  background: #d9f6e7;
  box-shadow: 0 7rpx 18rpx rgba(22, 71, 56, .12);
}

.profileEyebrow,
.heroEyebrow,
.sectionEyebrow {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
}

.profileEyebrow { color: #6c8178; }

.profileName {
  max-width: 370rpx;
  margin-top: 3rpx;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profileMeta { margin-top: 4rpx; color: #85928c; font-size: 20rpx; }

.deviceShortcut {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 13rpx 16rpx;
  border: 1rpx solid #d9e7e1;
  border-radius: 999rpx;
  color: #65766f;
  font-size: 19rpx;
  background: #fff;
}

.deviceDot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #9ca9a4; }
.deviceDot.connected { background: #22b77b; box-shadow: 0 0 0 6rpx rgba(34, 183, 123, .12); }

.trainingHero {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 31rpx 29rpx 28rpx;
  border: 1rpx solid rgba(98, 151, 111, .18);
  border-radius: 34rpx;
  background: linear-gradient(135deg, #d5f7df 0%, #b9efcc 54%, #98e1bc 100%);
  box-shadow: 0 18rpx 38rpx rgba(47, 125, 91, .16);
}

.heroGlow {
  position: absolute;
  right: -92rpx;
  bottom: -145rpx;
  width: 360rpx;
  height: 360rpx;
  border: 54rpx solid rgba(15, 66, 52, .08);
  border-radius: 50%;
  box-sizing: border-box;
}

.heroTop, .heroTitle, .heroStats, .heroButton { position: relative; z-index: 1; }
.heroEyebrow { color: #176b52; }
.heroDate { margin-top: 5rpx; color: #527568; font-size: 21rpx; }

.heroSource {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #184e3e;
  font-size: 18rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, .58);
}

.heroTitle {
  max-width: 570rpx;
  margin-top: 28rpx;
  font-size: 45rpx;
  line-height: 1.18;
  font-weight: 800;
}

.heroStats { gap: 20rpx; margin-top: 28rpx; }
.heroStat { display: flex; flex-direction: column; gap: 4rpx; }
.statValue { font-size: 27rpx; font-weight: 750; }
.statLabel { color: #5d786d; font-size: 18rpx; }
.statDivider { width: 1rpx; height: 46rpx; background: rgba(34, 87, 68, .18); }

.progressBadge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: auto;
  border: 8rpx solid rgba(255, 255, 255, .7);
  border-radius: 50%;
  color: #fff;
  background: #153f34;
  box-shadow: 0 8rpx 16rpx rgba(21, 63, 52, .2);
}

.progressBadge text {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 29rpx;
  line-height: 1;
  font-weight: 800;
}

.heroButton {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  margin: 25rpx 0 0;
  padding: 0 17rpx 0 28rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 78rpx;
  background: #143f35;
}

.heroButton::after { border: 0; }

.buttonArrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  color: #143f35;
  background: #c8f3d8;
}

.sectionHeading { margin-top: 34rpx; padding: 0 3rpx; }
.sectionEyebrow { color: #2a936d; }
.sectionTitle { margin-top: 5rpx; font-size: 31rpx; font-weight: 750; }
.sectionTag, .textLink { font-size: 20rpx; font-weight: 650; }
.sectionTag { padding: 8rpx 13rpx; border-radius: 999rpx; color: #277b5d; background: #e0f5e9; }
.textLink { color: #177052; }

.adviceCard,
.taskCard,
.insightCard {
  border: 1rpx solid #dbe7e2;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(24, 63, 51, .06);
}

.adviceCard { gap: 18rpx; margin-top: 17rpx; padding: 24rpx 21rpx; border-radius: 27rpx; }

.adviceIcon,
.insightIcon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #17523f;
  font-size: 18rpx;
  font-weight: 800;
  background: #c6f0d6;
}

.adviceIcon { width: 66rpx; height: 66rpx; border-radius: 20rpx; }
.adviceBody { flex: 1; }
.adviceTitle { font-size: 25rpx; font-weight: 750; }
.adviceText { margin-top: 7rpx; color: #728179; font-size: 21rpx; line-height: 1.55; }
.adviceArrow { padding: 15rpx 4rpx 15rpx 14rpx; color: #799087; font-size: 38rpx; }
.planHeading { margin-top: 36rpx; }

.taskCard { overflow: hidden; margin-top: 17rpx; padding: 0 22rpx; border-radius: 29rpx; }
.taskRow { min-height: 112rpx; gap: 16rpx; border-bottom: 1rpx solid #e8efec; }
.taskRow:last-child { border-bottom: 0; }

.taskIndex {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 47rpx;
  height: 47rpx;
  flex-shrink: 0;
  border-radius: 15rpx;
  color: #16543f;
  font-size: 21rpx;
  font-weight: 800;
  background: #d8f4e3;
}

.taskInfo { min-width: 0; flex: 1; }
.taskName { font-size: 25rpx; font-weight: 750; }
.taskHint { margin-top: 5rpx; overflow: hidden; color: #8a9691; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.taskSets { color: #48645a; font-size: 21rpx; font-weight: 650; }
.taskCheck { display: flex; width: 28rpx; height: 28rpx; flex-shrink: 0; align-items: center; justify-content: center; border: 3rpx solid #b8c8c1; border-radius: 50%; color: #fff; font-size: 17rpx; }
.taskCheck.checked { border-color: #238a67; background: #238a67; }

.insightGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 25rpx;
}

.insightCard { min-height: 230rpx; padding: 22rpx; border-radius: 28rpx; box-sizing: border-box; }
.deviceCard { background: #f0faf5; }
.insightIcon { width: 58rpx; height: 45rpx; border-radius: 15rpx; }
.insightIcon.dark { color: #d7f6e3; background: #173f35; }
.statusPill { padding: 7rpx 10rpx; border-radius: 999rpx; color: #7f8d87; font-size: 16rpx; background: #e4ebe8; }
.statusPill.online { color: #167250; background: #d5f3e2; }
.insightTitle { margin-top: 23rpx; color: #6f7e77; font-size: 19rpx; }
.insightValue { margin-top: 7rpx; overflow: hidden; font-size: 24rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.insightHint { margin-top: 18rpx; color: #819089; font-size: 18rpx; }
.miniArrow { color: #28785d; font-size: 30rpx; }
.recordMetrics { justify-content: space-between; margin-top: 24rpx; }
.metricValue { font-size: 35rpx; line-height: 1; font-weight: 800; }
.metricLabel { margin-top: 8rpx; color: #87938e; font-size: 17rpx; }
.bottomSpace { height: 34rpx; }

.home-page{padding-bottom:calc(36rpx + env(safe-area-inset-bottom))}.profileMain .avatar{color:#176b52;font-size:30rpx;font-weight:750}.profileMain .profileMeta{white-space:normal}.lesson-subtitle{position:relative;z-index:1;font-size:25rpx;color:#416d59;margin-top:12rpx}.hero-footnote{position:relative;margin-top:17rpx;color:#527568;font-size:19rpx}.home-page .progressBadge{width:102rpx;height:102rpx;flex-shrink:0}.home-page .progressBadge text{font-size:27rpx}.home-page .adviceBody{min-width:0}.home-page .taskHint{white-space:normal;line-height:1.6}.taskInfo{padding:20rpx 0}.rowArrow{color:#879d90;font-size:32rpx}.insightGrid{display:flex;gap:18rpx}.insightCard{width:calc(50% - 9rpx);min-width:0}.home-page .insightValue{white-space:normal;line-height:1.5;font-size:24rpx}.cardLink{font-size:18rpx;color:#216e50;margin-top:20rpx}.home-signature{text-align:center;font-size:22rpx;color:#6e8779;margin:40rpx 0 10rpx}.home-signature view{font-size:18rpx;margin-top:9rpx;color:#97a69e}.home-page .deviceShortcut{padding:12rpx;gap:7rpx}.home-page .profileName{max-width:320rpx}.home-page .heroTitle{font-size:43rpx}.home-page .heroButton{width:100%;height:82rpx}
