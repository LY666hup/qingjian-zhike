.report-score{display:flex;align-items:baseline;gap:12rpx;margin-top:30rpx}.report-score>text:first-child{font-size:106rpx;font-weight:750;line-height:1.2;letter-spacing:-4rpx}.report-score-unit{font-size:28rpx;color:#527568}.comparison-pill{font-size:23rpx;color:#215e41;background:rgba(255,255,255,.65);padding:8rpx 14rpx;border-radius:14rpx}.report-caption{font-size:20rpx;color:#527568;margin-top:10rpx}.report-grid{display:flex;gap:18rpx}.report-grid>.card{width:calc(50% - 9rpx);min-width:0}.report-grid .big{font-size:50rpx;margin-top:18rpx}.report-grid .hint{font-size:19rpx}.hero .row .name{font-size:28rpx}.report-grid .track{margin-bottom:0}

.goal-card{display:flex;align-items:center;gap:22rpx;padding:18rpx}.goal-ring{width:230rpx;flex-shrink:0}.goal-card .name{font-size:26rpx}.goal-count{font-size:46rpx;font-weight:700;color:#286e4e;margin:14rpx 0}.goal-count text{font-size:22rpx;font-weight:400;color:#8aa08f}.goal-card .muted{font-size:20rpx}.dimension-grid{display:flex;flex-wrap:wrap;gap:20rpx;border-top:1rpx solid #e7eee9;padding-top:24rpx}.dimension-grid>view{width:calc(50% - 10rpx)}.dimension-grid .muted{font-size:20rpx}.dimension-grid .name{font-size:25rpx}
