.class-name{font-size:38rpx;font-weight:650;margin-top:8rpx}.class-action{font-size:24rpx;color:#a7c8c5;margin-top:12rpx}.session-stats{display:flex;justify-content:space-between;margin:30rpx 0 26rpx;padding:24rpx 0;border-top:1rpx solid rgba(209,234,228,.12);border-bottom:1rpx solid rgba(209,234,228,.12)}.session-stats>view{flex:1}.session-stats>view+view{padding-left:24rpx;border-left:1rpx solid rgba(209,234,228,.12)}.session-stats text{font-size:42rpx;font-weight:600}.session-stats .stat-total{font-size:22rpx;color:#aac7c4;font-weight:400}.session-stats view view{font-size:20rpx;color:#aac7c4;margin-top:4rpx}.demo-controls{display:flex;gap:14rpx}.demo-controls .small-btn{flex:1;background:rgba(214,238,227,.08);border:1rpx solid rgba(209,234,228,.18);color:#b8d4cd;padding:0 12rpx;font-weight:400}.demo-controls .start{flex:1.6;background:#d3eee3;color:#214d45;border-color:#d3eee3;font-weight:600}.stream-caption{margin-top:18rpx;color:#8fadae;font-size:19rpx}.stream-caption .accent-dot{width:7rpx;height:7rpx;margin-right:8rpx}.attention-count{display:inline-block;margin-left:10rpx;background:#eee5d2;color:#9b7b42;font-size:22rpx;border-radius:8rpx;padding:0 10rpx;font-weight:500;vertical-align:middle}.attention-list{padding:0 26rpx;background:#fffdf9;border-color:#eee8db}.queue-index{font-size:24rpx;letter-spacing:1rpx;width:50rpx;color:#b0986a;font-weight:600}.queue-index.severe{color:#b28170}.attention-list .muted{font-size:22rpx}.chevron{font-size:32rpx;color:#afbdc0}.filter-tabs{gap:10rpx;flex-wrap:nowrap}.filter-tabs .tab{padding:13rpx 0;flex:1;text-align:center;font-size:23rpx}.student-card{padding:24rpx 26rpx}.student-card .avatar{width:66rpx;height:66rpx;border-radius:21rpx;font-size:26rpx}.student-card .name{font-size:28rpx}.student-id{font-size:18rpx;color:#98a7ab;letter-spacing:1rpx;margin-top:3rpx}.student-measures{display:flex;justify-content:space-between;margin-top:24rpx}.measure-label{font-size:20rpx;color:#8c9b9f;margin-bottom:4rpx}.reps-value{font-size:42rpx;line-height:1.2;font-weight:650}.score-block{text-align:right}.score-value{font-size:38rpx;font-weight:600;color:#3b8a78}.student-card .track{height:8rpx;margin:16rpx 0}.event-row{align-items:flex-start;gap:16rpx}.phase{font-size:20rpx;color:#8b9c9f;flex-shrink:0}.event-text{font-size:20rpx;color:#7d9297;text-align:right;word-break:break-all}.attention-card .event-text{color:#a58a52}.severe-card .event-text{color:#ab7c68}

.edit-mask{position:fixed;inset:0;background:rgba(15,40,27,.35);display:flex;align-items:center;justify-content:center;z-index:30;padding:28rpx}.edit-panel{width:100%;max-width:660rpx;background:#fff;border-radius:28rpx;padding:30rpx}.demo-controls{flex-wrap:wrap}

.edit-panel{max-height:85vh;overflow:auto}.setup-student{display:inline-flex;align-items:center;width:33.3%;padding:14rpx 0;font-size:25rpx}.setup-student checkbox{transform:scale(.8);transform-origin:left center}
