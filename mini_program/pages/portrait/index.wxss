.period-tabs{background:#e7eeed;border-radius:16rpx;padding:6rpx;gap:6rpx}.period-tabs .tab{flex:1;text-align:center;background:transparent;font-size:24rpx;padding:16rpx 8rpx;border-radius:12rpx}.period-tabs .active{background:#fff;color:#2d7869;box-shadow:0 3rpx 8rpx rgba(25,60,51,.06)}.chart-description{font-size:21rpx;color:#94a3a8;margin-top:8rpx}.chart-legend{display:flex;align-items:center;gap:8rpx;font-size:18rpx;color:#8a9d9a}.chart-legend text{width:12rpx;height:12rpx;background:#63aa99;border-radius:3rpx}.error-chart-row{display:flex;align-items:center;gap:18rpx;margin:20rpx 0}.error-chart-label{font-size:21rpx;color:#90a0a4;width:65rpx;flex-shrink:0}.error-chart-track{flex:1;background:#f5f2eb;height:16rpx;border-radius:5rpx;overflow:hidden}.error-chart-track view{height:100%;background:#d3b17b;border-radius:5rpx}.error-chart-value{font-size:23rpx;color:#a18456;width:25rpx;text-align:right}.error-chart-scale{display:flex;justify-content:space-between;margin:0 40rpx 0 82rpx;color:#a5b0b2;font-size:17rpx}.summary-card{border-radius:22rpx;background:#eaf3ec;padding:26rpx 28rpx;margin:16rpx 0;border:1rpx solid #deeade}.summary-label{font-size:20rpx;color:#7a9b82;letter-spacing:2rpx}.summary-title{font-size:31rpx;font-weight:600;color:#3e7958;margin-top:8rpx}.summary-sub{font-size:21rpx;color:#88a491;margin-top:10rpx}.summary-card.focus{background:#f6f1e7;border-color:#ece3d1}.focus .summary-label,.focus .summary-sub{color:#a5916b}.focus .summary-title{color:#947742}

.action-filter{display:flex;justify-content:space-between;padding:20rpx 24rpx;border-radius:18rpx;background:white;border:1rpx solid #dfe9e3;font-size:25rpx;margin-top:24rpx}.action-filter text{color:#6e8a77;font-size:22rpx}.trend-overview{background:#e8f4ec;border:1rpx solid #d7e8dd;border-radius:24rpx;padding:26rpx}.trend-overview .big{font-size:46rpx;margin-top:12rpx}.trend-overview .muted{font-size:21rpx}.column{padding-top:4rpx}

.visual-legend{display:flex;gap:12rpx;align-items:center;justify-content:center;font-size:20rpx;color:#84998b}.legend-dot{display:inline-block;width:14rpx;height:14rpx;border-radius:4rpx;background:#2b9b70;flex-shrink:0}.legend-dot.pale{background:#b0ddc5}.legend-line{width:28rpx;height:4rpx;background:#246b4c;display:inline-block;margin-left:14rpx}.report-date-links{margin-top:24rpx;border-top:1rpx solid #e8efea;padding-top:12rpx}.report-date-links>view{display:flex;justify-content:space-between;padding:12rpx 0;color:#839a8c;font-size:20rpx}.distribution-legend>view{display:flex;gap:14rpx;align-items:center;padding:12rpx 0;font-size:24rpx;color:#71917e}.distribution-legend .name{margin-left:auto;font-size:25rpx}.heat-week{display:flex;margin-top:26rpx;font-size:19rpx;color:#98a99d}.heat-week text{width:14.285%;text-align:center}.heat-grid{display:flex;flex-wrap:wrap;margin:12rpx -4rpx}.heat-cell{width:calc(14.285% - 8rpx);height:60rpx;margin:4rpx;display:flex;align-items:center;justify-content:center;border-radius:10rpx;font-size:20rpx}.level-0{background:#eef3ef;color:#a3b3a8}.level-1{background:#b7e2c7;color:#30664a}.level-2{background:#67bc8b;color:#fff}.level-3{background:#26764b;color:#fff}.heat-cell.future{opacity:.35}.heat-key{display:flex;justify-content:flex-end;align-items:center;gap:8rpx;font-size:16rpx;color:#9aaca0;margin-top:12rpx}.heat-key view{width:20rpx;height:20rpx;border-radius:5rpx}.chart-description{line-height:1.6}
