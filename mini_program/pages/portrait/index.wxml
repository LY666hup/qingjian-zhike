<view class="page"><view class="page-heading"><view class="eyebrow">MOVEMENT PROFILE</view><view class="title">{{student ? student.name : '个人'}}的运动画像</view><view class="subtitle">把每次练习，连成看得见的进步</view></view><demo-notice/><picker mode="selector" range="{{actionNames}}" value="{{actionIndex}}" bindchange="action"><view class="action-filter">{{actionNames[actionIndex]}}<text>切换项目 ▾</text></view></picker><view class="tabs period-tabs"><view class="tab {{period==='7'?'active':''}}" bindtap="period" data-value="7">最近7次训练</view><view class="tab {{period==='30'?'active':''}}" bindtap="period" data-value="30">最近30天</view></view><view wx:if="{{error}}" class="error" bindtap="refresh">{{error}} · 点击重试</view><view wx:if="{{loading}}" class="empty">正在整理运动画像…</view><block wx:if="{{history}}"><view class="row trend-overview"><view><view class="muted">本窗口训练记录</view><view class="big">{{summary.count}}<text class="unit">次</text></view></view><view><view class="muted">平均动作质量</view><view class="big">{{summary.average}}<text class="unit">分</text></view></view></view><view class="hint">{{actionIndex===0?'包含多个项目，建议筛选同项目后比较。':'当前仅展示所选项目。'}} 数据截止 {{history.as_of||'未提供'}}。</view><view wx:if="{{!history.points.length}}" class="empty">所选范围暂无训练记录</view><block wx:if="{{history.points.length}}">
<view class="card"><view class="name">训练次数与动作质量</view><view class="chart-description">左轴：完成次数 · 右轴：评分（0–100）</view><training-chart model="{{comboChart}}" height="420"/><view class="visual-legend"><text class="legend-dot pale"/>完成次数<text class="legend-line"/>动作评分</view><view class="report-date-links"><view wx:for="{{history.points}}" wx:key="report_id" bindtap="report" data-id="{{item.report_id}}"><text>{{item.date}}</text><text>{{item.reps}}次 · {{item.score}}分 ›</text></view></view></view>
<view class="card"><view class="name">五维动作画像</view><view class="chart-description">当前筛选记录的维度均值 · 0–100分</view><training-chart model="{{radarChart}}" height="480"/><view class="hint">幅度、节奏等为归一化指标，不是角度或物理速度；缺少维度时不绘制假分数。</view></view>
<view class="card"><view class="name">你的训练项目分布</view><view class="chart-description">按本窗口的训练记录次数统计</view><training-chart model="{{distributionChart}}" height="370"/><view class="distribution-legend"><view wx:for="{{distribution}}" wx:key="label"><text class="legend-dot" style="background:{{item.color}}"/><text>{{item.label}}</text><text class="name">{{item.value}} 次</text></view></view></view>
<view class="card"><view class="name">训练日历热力图</view><view class="chart-description">当前筛选记录 · 深色表示当日记录更多</view><view class="heat-week"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view><view class="heat-grid"><view wx:for="{{heatmap}}" wx:key="date" class="heat-cell level-{{item.level}} {{item.future?'future':''}}" bindtap="heat" data-id="{{item.report_id}}"><text>{{item.day}}</text></view></view><view class="heat-key"><text>无当前记录</text><view class="level-0"/><view class="level-1"/><view class="level-2"/><view class="level-3"/><text>更多记录</text></view><view class="hint">计划与实际记录分开显示。点有记录的日期可查看报告；空格不代表缺勤。</view></view>
<view class="card"><view class="row"><text class="name">动作事件变化</text><text class="section-note">单位：次</text></view><view class="error-chart-row" wx:for="{{history.points}}" wx:key="report_id"><text class="error-chart-label">{{item.label}}</text><view class="error-chart-track"><view style="width:{{item.event_percent}}%"/></view><text class="error-chart-value">{{item.event_count}}</text></view><view class="error-chart-scale"><text>0</text><text>{{eventMax}} 次</text></view></view>
</block><view class="section">运动表现摘要</view><view class="summary-card"><view class="summary-label">已记录的表现</view><view class="summary-title">{{history.strength}}</view></view><view class="summary-card focus"><view class="summary-label">后续关注</view><view class="summary-title">{{history.focus}}</view><view class="summary-sub">供教师结合现场表现参考</view></view></block></view>
