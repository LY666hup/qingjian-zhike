<view class="page"><view class="page-heading"><view class="eyebrow">MOVEMENT ARCHIVE</view><view class="title">记录每一次进步</view><view class="subtitle">{{isStudent?'从自己的训练记录，找到成长的线索':'从一次课堂，到每个学生的训练表现'}}</view></view><demo-notice/>
<view class="card filter-panel"><view class="row"><text class="name">筛选训练记录</text><text class="link" bindtap="clearFilters">重置筛选</text></view><picker mode="selector" range="{{actionNames}}" value="{{actionIndex}}" bindchange="action"><view class="filter-choice">{{actionNames[actionIndex]}}<text>▾</text></view></picker><view class="date-filters"><picker mode="date" value="{{startDate}}" bindchange="start"><view>{{startDate||'开始日期'}} ▾</view></picker><text>至</text><picker mode="date" value="{{endDate}}" bindchange="end"><view>{{endDate||'结束日期'}} ▾</view></picker></view></view>
<view wx:if="{{error}}" class="error" bindtap="refresh">{{error}} · 点击重试</view><view wx:if="{{loading}}" class="empty">正在查询记录…</view>
<block wx:if="{{isStudent}}"><view class="tabs"><view class="tab {{period==='7'?'active':''}}" bindtap="period" data-value="7">最近7次</view><view class="tab {{period==='30'?'active':''}}" bindtap="period" data-value="30">最近30天</view></view><view wx:for="{{personalPoints}}" wx:key="report_id" class="card personal-record" bindtap="report" data-id="{{item.report_id}}"><view class="row"><view class="grow"><view class="name">{{item.action_name}}专项训练</view><view class="muted">{{item.date}} · {{item.reps}} / {{item.target_reps}} 次</view></view><view class="record-quality">{{item.score}}<text>分</text></view></view><view class="archive-bottom"><text>查看这一次的完整报告</text><text>↗</text></view></view><view wx:if="{{!loading ? !personalPoints.length : false}}" class="empty">这个范围内暂无个人训练记录</view><view class="hint">样例统计截止 {{asOf||'2026-10-21'}}。最近7次为筛选后的最近7条；最近30天以数据截止日为基准。</view></block>
<block wx:else=""><view class="section"><text>历史课堂</text><text class="section-note">{{records.length}} 节课程</text></view><view wx:for="{{records}}" wx:key="id" class="card archive-card" bindtap="open" data-id="{{item.id}}"><view class="row"><view class="archive-date"><view class="calendar-icon"><image src="/assets/icons/history-active.png"/></view><text>{{item.date}}</text></view><text class="archive-status">样例归档</text></view><view class="archive-body"><view class="grow"><view class="archive-class">{{item.class_name}}</view><view class="archive-action">{{item.action_name}}专项训练</view><view class="archive-count">{{item.student_count}} 人参与</view></view><view class="archive-score"><text>{{item.average_score}}</text><view>平均动作质量</view></view></view><view class="archive-bottom"><text>展开课堂 · 查看学生报告</text><text>↗</text></view></view><view wx:if="{{!loading ? !records.length : false}}" class="empty">这个范围内暂无历史课堂</view>
<view wx:if="{{selected}}" id="classroom-review" class="card review-card"><view class="row"><view><view class="name">{{selected.action_name}} · 课堂回顾</view><view class="muted">{{selected.date}} · {{selected.class_name}}</view></view><text class="link" bindtap="close">收起</text></view><view wx:if="{{detailLoading}}" class="empty">正在加载学生报告…</view><view wx:if="{{detailError}}" class="error">{{detailError}}</view><view wx:for="{{selectedReports}}" wx:key="report_id" class="list-row row" bindtap="report" data-id="{{item.report_id}}" data-student="{{item.student_id}}"><view class="grow"><view class="name">{{item.name}}</view><view class="muted">完成 {{item.reps}} 次 · {{item.errors.length}} 类动作事件</view></view><text class="pill">{{item.score}} 分</text><text class="link">›</text></view></view></block><view class="footer">每一份记录，都是下一次进步的起点</view></view>
