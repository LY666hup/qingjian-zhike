.archive-card{padding:24rpx 26rpx 0;overflow:hidden}.archive-date{display:flex;align-items:center;gap:12rpx;color:#7e9298;font-size:22rpx}.calendar-icon{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;background:#eff5f2;border-radius:11rpx}.calendar-icon image{width:26rpx;height:26rpx}.archive-status{font-size:18rpx;color:#90a498}.archive-body{display:flex;align-items:center;gap:16rpx;margin:26rpx 0}.archive-class{font-size:34rpx;font-weight:650}.archive-action{font-size:24rpx;color:#677f85;margin-top:5rpx}.archive-count{font-size:20rpx;color:#9aabad;margin-top:14rpx}.archive-score{text-align:right;background:#f0f7f3;border-radius:19rpx;padding:18rpx 20rpx}.archive-score text{font-size:48rpx;line-height:1.2;font-weight:650;color:#3b806e}.archive-score view{font-size:17rpx;color:#89a094;margin-top:4rpx}.archive-bottom{border-top:1rpx solid #edf1f2;padding:20rpx 0;display:flex;justify-content:space-between;font-size:22rpx;color:#5d8b7d}.review-card{border-color:#b9d7ca}

