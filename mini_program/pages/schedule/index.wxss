.calendar-card{padding:24rpx 16rpx}.calendar-header{display:flex;align-items:center;justify-content:space-between;text-align:center;padding:6rpx 12rpx 24rpx}.month-arrow{width:60rpx;height:60rpx;line-height:52rpx;padding:0;background:#eef6f0;color:#42785b;font-size:42rpx;border-radius:50%}.month-title{font-size:34rpx;font-weight:700}.calendar-hint{font-size:18rpx;color:#92a497;margin-top:4rpx}.weekday-row{display:flex;color:#92a497;font-size:21rpx;padding:16rpx 0}.weekday-row text{width:14.285%;text-align:center}.calendar-grid{display:flex;flex-wrap:wrap}.calendar-day{width:14.285%;height:104rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:7rpx;position:relative}.day-number{font-size:25rpx;line-height:1.2}.calendar-day.outside{color:#c5cfc8}.calendar-day.selected{background:#173f35;color:#fff}.calendar-day.today .day-number{font-weight:800;text-decoration:underline;text-underline-offset:5rpx}.lesson-tag{font-size:15rpx;background:#dff3e7;color:#327651;padding:3rpx 6rpx;border-radius:6rpx;max-width:100%;white-space:nowrap}.selected .lesson-tag{background:rgba(255,255,255,.16);color:#d8f4e1}.rest-dot{height:15rpx;width:5rpx}.calendar-key{display:flex;gap:10rpx;align-items:center;font-size:18rpx;color:#91a295;margin:18rpx 16rpx 4rpx}.lesson-dot,.today-dot{width:10rpx;height:10rpx;border-radius:50%;background:#94cfaa}.today-dot{background:#173f35;margin-left:22rpx}.lesson-title{font-size:32rpx;font-weight:650;margin:18rpx 0 8rpx}.lesson-time{font-size:22rpx;font-weight:600;color:#42815b}.lesson-focus{font-size:24rpx;color:#728c7b;margin-top:24rpx;line-height:1.6}
