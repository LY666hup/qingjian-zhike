page{background:#f3f6f7;color:#20353b;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.5}
view,text,button,input,image{box-sizing:border-box}
button{font-size:27rpx;border-radius:18rpx;margin:0;font-weight:600}button::after{border:0}button:active{opacity:.84}
.page{padding:30rpx 32rpx calc(44rpx + env(safe-area-inset-bottom))}
.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.row>text{min-width:0}
.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#738b91;font-weight:600}
.title{font-size:44rpx;font-weight:700;letter-spacing:-1rpx;line-height:1.3;margin:12rpx 0}
.subtitle,.muted{color:#7a8d93;font-size:24rpx;line-height:1.6}
.section{font-size:30rpx;font-weight:650;margin:36rpx 0 20rpx;display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.section .muted{font-size:22rpx;font-weight:400}
.card{padding:28rpx;background:#fff;border:1rpx solid #e8edef;border-radius:26rpx;margin:20rpx 0;box-shadow:0 6rpx 20rpx rgba(28,58,65,.025)}
.hero{position:relative;overflow:hidden;background:#153f45;color:#fff;border:0;padding:32rpx;box-shadow:0 12rpx 28rpx rgba(21,63,69,.12)}
.hero .subtitle,.hero .eyebrow{color:#aacac8}.hero .title{margin:20rpx 0 8rpx}.hero .pill{background:rgba(209,241,231,.14);color:#d4ede7}
.primary{background:#157d70;color:#fff;line-height:86rpx;margin-top:24rpx;letter-spacing:1rpx}
.secondary{background:#edf5f2;color:#237a6d;line-height:78rpx;margin-top:16rpx}
.small-btn{font-size:23rpx;line-height:68rpx;padding:0 22rpx;background:#edf5f2;color:#237a6d}
.pill{display:inline-block;flex-shrink:0;padding:6rpx 14rpx;font-size:21rpx;line-height:1.5;border-radius:10rpx;background:#ecf5f0;color:#37775e}
.pill.attention{background:#fbf3e2;color:#986f29}.pill.severe{background:#f8ebe6;color:#a05d49}.pill.offline{background:#edf0f1;color:#7a8d93}
.link{color:#227c70;font-size:24rpx}.grid{display:flex;flex-wrap:wrap;gap:18rpx}.grid>.card{width:calc(50% - 9rpx);margin:0}
.big{font-size:54rpx;font-weight:650;line-height:1.3;letter-spacing:-1rpx;font-variant-numeric:tabular-nums}.unit{font-size:22rpx;font-weight:400;letter-spacing:0;color:#8a9a9f;margin-left:8rpx}
.divider{border-top:1rpx solid #edf1f2;margin:24rpx 0}.list-row{padding:24rpx 0;border-bottom:1rpx solid #eef2f3}.list-row:last-child{border:0}
.name{font-size:29rpx;font-weight:600}.avatar{width:76rpx;height:76rpx;border-radius:24rpx;background:#e8f2ee;color:#327c6a;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:600;flex-shrink:0}
.grow{flex:1;min-width:0}.notice{padding:20rpx 24rpx;border:1rpx solid #ede5d5;background:#fbf7ed;color:#917c50;border-radius:16rpx;font-size:22rpx;margin:22rpx 0}
.hint{font-size:22rpx;line-height:1.7;color:#8b9a9f;margin:20rpx 0}.empty{padding:52rpx 20rpx;text-align:center;color:#8a9a9f;font-size:25rpx}.error{background:#f8ebe6;color:#a05d49;padding:22rpx;border-radius:16rpx}
.tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:22rpx 0}.tab{padding:14rpx 24rpx;font-size:24rpx;background:#e9eff0;color:#71878d;border-radius:14rpx}.tab.active{background:#183f45;color:#fff}
.search{height:84rpx;border:1rpx solid #e6edef;background:#fff;border-radius:18rpx;padding:0 26rpx;margin:20rpx 0;font-size:25rpx}
.track{height:10rpx;border-radius:10rpx;background:#edf2f1;overflow:hidden;margin:16rpx 0}.fill{height:100%;background:#329d89;border-radius:10rpx}
.attention-card{border-left:5rpx solid #d9b56b}.severe-card{border-left:5rpx solid #c9907c}.bar-row{margin:26rpx 0}.hero button{background:#d3eee3;color:#214d45}
.footer{font-size:20rpx;color:#99a7ab;text-align:center;margin:36rpx 0}.status-line{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}
.chart{display:flex;align-items:flex-end;justify-content:space-around;min-height:280rpx;padding:30rpx 0 8rpx;gap:8rpx;background:repeating-linear-gradient(to top,transparent 0,transparent 59rpx,#edf2f2 60rpx,#edf2f2 61rpx)}
.column{flex:1;text-align:center;min-width:0}.bar{width:50%;margin:auto;background:#63aa99;border-radius:7rpx 7rpx 0 0}.column:last-child .bar{background:#237e6e}.chart-label{font-size:18rpx;color:#8a9a9f;margin-top:10rpx;background:#fff}.chart-value{font-size:22rpx;font-weight:600;color:#378373;margin-bottom:8rpx}
.step{position:relative;padding:22rpx 0 22rpx 30rpx;border-left:2rpx solid #dcebe5}.step::before{content:"";position:absolute;left:-7rpx;top:36rpx;width:12rpx;height:12rpx;border-radius:50%;background:#65aa91;border:3rpx solid #fff}.step .name{font-size:27rpx}
.mini{font-size:21rpx}.left{justify-content:flex-start}.topgap{margin-top:24rpx}.icon{width:38rpx;height:38rpx;flex-shrink:0}
.section-note{font-size:20rpx;font-weight:400;color:#8e9fa4;letter-spacing:1rpx}.page-heading{margin-bottom:20rpx}.page-heading .title{font-size:42rpx}.accent-dot{width:10rpx;height:10rpx;border-radius:50%;background:#78bca2;display:inline-block;margin-right:10rpx}

/* Reference palette: soft mint, deep green, quiet white cards. */
page{background:#f3f7f5;color:#17251f}.card{border-color:#dfe9e3;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(24,63,51,.04)}.hero{background:linear-gradient(135deg,#d5f7df,#b9efcc 54%,#98e1bc);color:#173f35;border:1rpx solid #bfe3cb;box-shadow:0 14rpx 30rpx rgba(47,125,91,.12)}.hero .eyebrow,.hero .subtitle,.hero .hint{color:#4d7461}.hero .pill{color:#19553e;background:rgba(255,255,255,.65)}.primary{background:#173f35}.secondary,.small-btn{background:#e1f3e6;color:#236b4b}.tab.active{background:#173f35}.muted,.subtitle{color:#72857b}.link{color:#237b59}.fill{background:#3b9e73}.selected-card{border:2rpx solid #298a63;background:#edf9f1}.hero .class-action,.hero .session-stats view view,.hero .session-stats .stat-total,.hero .stream-caption{color:#4d7461}.hero .session-stats,.hero .session-stats>view+view{border-color:rgba(34,87,68,.18)}.hero .demo-controls .small-btn{background:rgba(255,255,255,.6);border-color:#b2d5bf;color:#28583f}.hero .demo-controls .start{background:#173f35;border-color:#173f35;color:white}.page-heading .title{font-size:40rpx}.card .hint:last-child{margin-bottom:0}

button.primary,button.secondary{display:block;width:100%;box-sizing:border-box}
